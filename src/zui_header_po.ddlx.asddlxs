@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
    typeName: 'Purchase Detail',
    typeNamePlural: 'Purchase Details',
    title: {
    value : 'Pono' }
}
annotate entity zp_header_po with
{

  @UI.facet: [{
  
  purpose: #STANDARD,
  position: 10,
  label: 'Header',
  type: #IDENTIFICATION_REFERENCE
  },
  {
 
  purpose: #STANDARD,
  position: 20,
  label: 'Item',
  type: #LINEITEM_REFERENCE,
  targetElement: '_item'
  }]


  @UI.lineItem: [{ position: 10,
                   label: 'Po No' ,
                   importance: #HIGH }]
  @UI.identification: [{ position: 10, label: 'Po NO' }]
  Pono;


  @UI.lineItem: [{ position: 20, label: 'Company' ,importance: #HIGH }]
  @UI.identification: [{ position: 20, label: 'Company' }]
  Pocompany;

  @UI.lineItem: [{ position: 30, label: 'PO Date' , importance: #HIGH }]
  @UI.identification: [{ position: 30, label: 'PO Date' }]

  Podate;

  @UI.lineItem: [{ position: 40, label: 'Desc' ,importance: #HIGH }]
  @UI.identification: [{ position: 40, label: 'Desc' }]
  Podesc;

  @UI.lineItem: [{ position: 50, label: 'Status' ,importance: #HIGH }]
  @UI.identification: [{ position: 50, label: 'Status' }]
  Postatus;

}