@Metadata.layer: #CORE
annotate entity zsc_c_passenger with
{

  @UI.facet: [ {
    id:       'Passenger',
    purpose:  #STANDARD,
    type:     #IDENTIFICATION_REFERENCE,
    label:    'Passenger Details',
    position: 10
  }]
  
  @UI.lineItem: [ { position: 10, importance: #HIGH , label: 'Booking Id' }  ]
  @UI.identification: [ { position: 10 , label: 'Booking Id' } ]
  BookingId;

  @UI.lineItem: [ { position: 20, importance: #HIGH , label: 'Passenger No' }  ]
  @UI.identification: [ { position: 20 , label: 'Passenger No' } ]
  PassengerNo;

  @UI.lineItem: [ { position: 30, importance: #HIGH , label: 'Name' }  ]
  @UI.identification: [ { position: 30 , label: 'Name' } ]
  Name;

  @UI.lineItem: [ { position: 40, importance: #HIGH , label: 'SeatNo' }  ]
  @UI.identification: [ { position: 40 , label: 'SeatNo' } ]
  SeatNo;

  @UI.lineItem: [ { position: 50, importance: #HIGH , label: 'Status' }  ]
  @UI.identification: [ { position: 50 , label: 'Status' } ]
  TicketStatus;

}