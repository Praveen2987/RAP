annotate view zcds_empl_det with
{
  /* --- Facets (Object Page sections) --- */
  @UI.facet: [
    {
      id: 'General',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'General Information',
      position: 10,
      targetQualifier: 'General'   // links to @UI.identification(... qualifier = 'General')
    }
  ]

//
//@ui.facet: [{
//    qualifier: '',
//    feature: '',
//    id: '',
//    purpose: #STANDARD,
//    parentId: '',
//    position: ,
//    exclude: true,
//    hidden: true,
