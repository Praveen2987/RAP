//    isMap: true,
//    importance: ,
//    label: '',
//    type: ,
//    targetElement: '',
//    targetQualifier: '',
//    url: ''
//}]



  /* --- Empid --- */
  @UI.lineItem: [
    { position: 10, label: 'EmpId' }
  ]
  @UI.identification: [
    { position: 10, label: 'EmpId', qualifier: 'General' }
  ]
  
  @UI.dataPoint: {
      qualifier: 'EmpId',
//      hidden: true,
      title: 'Employee Id'
//      description: '',
//      longDescription: '',
//      targetValue: ,
//      targetValueElement: '',
//      forecastValue: '',
//      minimumValue: ,
//      maximumValue: ,
//      visualization: ,
//      valueFormat: {
//          scaleFactor: ,
//          numberOfFractionalDigits: 
//      },
//      referencePeriod: {
//          description: '',
//          start: '',
//          end: ''
//      },
//      criticality: '',
//      withCriticalityLabels: true,
//      criticalityValue: ,
//      criticalityRepresentation: #WITHOUT_ICON,
//      criticalityCalculation: {
//          improvementDirection: ,
//          acceptanceRangeLowValue: ,
//          acceptanceRangeHighValue: ,
//          toleranceRangeLowValue: ,
//          toleranceRangeLowValueElement: '',
//          toleranceRangeHighValue: ,
//          toleranceRangeHighValueElement: '',
//          deviationRangeLowValue: ,
//          deviationRangeLowValueElement: '',
//          deviationRangeHighValue: ,
//          deviationRangeHighValueElement: '',
//          constantThresholds: [{
//              aggregationLevel: [ '' ],
//              acceptanceRangeLowValue: ,
//              acceptanceRangeHighValue: ,
//              toleranceRangeLowValue: ,
//              toleranceRangeHighValue: ,
//              deviationRangeLowValue: ,
//              deviationRangeHighValue: 
//          }]
//      },
//      trend: '',
//      trendCalculation: {
//          referenceValue: '',
//          isRelativeDifference: true,
//          upDifference: ,
//          upDifferenceElement: '',
//          strongUpDifference: ,
//          strongUpDifferenceElement: '',
//          downDifference: ,
//          downDifferenceElement: '',
//          strongDownDifference: ,
//          strongDownDifferenceElement: ''
//      },
//      responsible: '',
//      responsibleName: ''
  }

  Empid;

  /* --- Empdesg --- */
  @UI.lineItem: [
    { position: 20, label: 'EmpDesg' }
  ]
  @UI.identification: [
    { position: 20, label: 'EmpDesg', qualifier: 'General' }
  ]
  Empdesg;

  /* --- Empsal --- */
  @UI.lineItem: [
    { position: 30, label: 'EmpSal' }
  ]
  @UI.identification: [
    { position: 30, label: 'EmpSal', qualifier: 'General' }
  ]
  Empsal;
}



